# Copy to .env.local and configure your isolated Supabase development project.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional privileged credential. Prefer guarded RPCs; never expose this publicly.
SUPABASE_SECRET_KEY=

# Insight works deterministically without external AI. External inference is sample-only.
AI_ASSISTANT_ENABLED=false
# Explicit candidate-model evaluation gate. Real workspace data remains blocked.
OPENROUTER_SAMPLE_EVALUATION=false
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
