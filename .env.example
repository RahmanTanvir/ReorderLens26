# Copy only if .env.local does not already exist. Keep configured local values.
# Use the URL and publishable key from the same isolated Supabase project.
# The legacy NEXT_PUBLIC_SUPABASE_ANON_KEY name is not supported.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Not required by current workflows, which use authenticated guarded RPCs/RLS.
# Leave blank; never put a secret/service-role key in a NEXT_PUBLIC_ setting.
SUPABASE_SECRET_KEY=

# Insight works deterministically without external AI. External inference is sample-only.
AI_ASSISTANT_ENABLED=false
# Explicit candidate-model evaluation gate. Real workspace data remains blocked.
OPENROUTER_SAMPLE_EVALUATION=false
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
