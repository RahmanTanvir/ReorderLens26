# P0 starts without service credentials. Configure Supabase in P2.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional privileged credential. Prefer guarded RPCs; never expose this publicly.
SUPABASE_SECRET_KEY=

# External AI is unavailable in P0. Leave disabled until P8 evaluation/privacy review.
AI_ASSISTANT_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_PRIMARY_MODEL=
OPENROUTER_FALLBACK_MODELS=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
